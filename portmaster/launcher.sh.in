#!/bin/bash
# @TITLE@ for PortMaster (KNULLI, muOS, ROCKNIX, ArkOS, NextUI / NX Redux and more).
# Runs on PortMaster's Python 3.11 runtime with NumPy and pygame bundled in pylib/.

XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
if [ -d "/opt/system/Tools/PortMaster/" ]; then
  controlfolder="/opt/system/Tools/PortMaster"
elif [ -d "/opt/tools/PortMaster/" ]; then
  controlfolder="/opt/tools/PortMaster"
elif [ -d "$XDG_DATA_HOME/PortMaster/" ]; then
  controlfolder="$XDG_DATA_HOME/PortMaster"
else
  controlfolder="/roms/ports/PortMaster"
fi

source $controlfolder/control.txt
[ -f "${controlfolder}/mod_${CFW_NAME}.txt" ] && source "${controlfolder}/mod_${CFW_NAME}.txt"
get_controls

GAMEDIR="$(cd "$(dirname "$0")" && pwd)/@DIR@"
[ -d "$GAMEDIR" ] || GAMEDIR="/$directory/ports/@DIR@"
cd "$GAMEDIR" || exit 1

[ -f "$GAMEDIR/log.txt" ] && mv -f "$GAMEDIR/log.txt" "$GAMEDIR/log.prev.txt"
> "$GAMEDIR/log.txt" && exec > >(tee "$GAMEDIR/log.txt") 2>&1
echo "=== @TITLE@ (PortMaster) $(date) ==="
echo "CFW: $CFW_NAME  device: $DEVICE_NAME  arch: $DEVICE_ARCH  screen: ${DISPLAY_WIDTH}x${DISPLAY_HEIGHT}"

runtime="python_3.11"
export python_dir="$HOME/python_3.11"
mkdir -p "${python_dir}"

if [ ! -f "$controlfolder/libs/${runtime}.squashfs" ]; then
  if [ ! -f "$controlfolder/harbourmaster" ]; then
    pm_message "This port needs the latest PortMaster to run. See https://portmaster.games/ for more info."
    sleep 5
    exit 1
  fi
  $ESUDO $controlfolder/harbourmaster --quiet --no-check runtime_check "${runtime}.squashfs"
fi

if [[ "$PM_CAN_MOUNT" != "N" ]]; then
  $ESUDO umount "${python_dir}" 2>/dev/null
fi
$ESUDO mount "$controlfolder/libs/${runtime}.squashfs" "${python_dir}"

export SDL_GAMECONTROLLERCONFIG="$sdl_controllerconfig"
export BRICK_EDITION="@EDITION@"
export OPENBLAS_NUM_THREADS=1

# Audio needs steady CPU: full speed while the app is open, then put the governor back.
GOV=/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
OLDGOV=$(cat $GOV 2>/dev/null)
for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance | $ESUDO tee "$g" >/dev/null 2>&1; done

pm_platform_helper "${python_dir}/bin/python3"

source "${python_dir}/bin/activate"
export PYTHONHOME="${python_dir}"
export PYTHONPATH="${GAMEDIR}/pylib"
export PYTHONPYCACHEPREFIX="${GAMEDIR}/${runtime}.cache"

# The app reads the controller itself (first launch: press each button once).
# Quit from Settings > Quit.
"${python_dir}/bin/python3" -u "${GAMEDIR}/launch.py"
echo "exit $?"

[ -n "$OLDGOV" ] && for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo "$OLDGOV" | $ESUDO tee "$g" >/dev/null 2>&1; done
if [[ "$PM_CAN_MOUNT" != "N" ]]; then
  $ESUDO umount "${python_dir}"
fi
pm_finish
